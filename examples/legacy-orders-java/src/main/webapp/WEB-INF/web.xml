<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
  <display-name>legacy-orders</display-name>

  <servlet>
    <servlet-name>LegacyExportServlet</servlet-name>
    <servlet-class>com.acme.legacy.LegacyExportServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LegacyExportServlet</servlet-name>
    <url-pattern>/export/*</url-pattern>
    <url-pattern>*.csv</url-pattern>
  </servlet-mapping>
</web-app>
