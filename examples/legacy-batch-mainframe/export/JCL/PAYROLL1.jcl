//PAYROLL1 JOB (ACCT123),'NIGHTLY PAYROLL',CLASS=A,MSGCLASS=X,
//             REGION=0M
//*
//* Synthetic nightly payroll job: extract, calculate, report.
//* No real system, dataset, or credential is referenced.
//*
//         JCLLIB ORDER=(PROD.PROCLIB)
//         SET ENV=PROD
//JOBLIB   DD DSN=&ENV..LOADLIB,DISP=SHR
//EXTRACT  EXEC PGM=PAYEXTR,PARM='FULL'
//EMPMAST  DD DSN=PROD.PAYROLL.EMPMAST,DISP=SHR
//CUSTREC  DD DSN=PROD.COPYLIB(CUSTREC),DISP=SHR
//EXTRACT  DD DSN=&&EXTRACT,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(10,5))
//SYSIN    DD *
SELECT DEPT=FIN
